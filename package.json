{
  "name": "sma-chart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && playwright install chromium",
    "serve": "node scripts/serve.js",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "test": "vitest run && playwright test",
    "mutate": "node scripts/mutation/run.mjs",
    "mutate:check": "node scripts/mutation/run.mjs --check",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "lightweight-charts": "5.3.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
